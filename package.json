    "generate": "node scripts/generate-map.js",
    "validate": "node scripts/validate-map.mjs",
    "examples": "node scripts/sdk-examples.js",
    "demo:build": "node scripts/build-demo.mjs",
    "demo": "node scripts/serve-demo.mjs",
    "preview:render": "node scripts/render-preview.mjs",
    "sdk:pack": "node scripts/pack-sdk.mjs",
