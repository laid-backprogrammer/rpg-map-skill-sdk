{
  "name": "rpg-map-skill-sdk",
  "version": "0.3.0",
  "private": true,
  "description": "Blockout-first RPG map workflow, agent skills, and a deterministic map SDK.",
  "type": "module",
  "license": "MIT",
  "workspaces": ["packages/map-sdk"],
  "scripts": {
    "test": "node --test",
    "check:types": "tsc --project tsconfig.json",
